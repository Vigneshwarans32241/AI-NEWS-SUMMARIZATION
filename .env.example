# ===================================================
# Backend Environment Configuration
# Copy this file to .env and fill in your values
# ===================================================

# Groq API Key (Required for AI News Summarization & Quiz Generation)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# JWT Authentication Secret (Use a strong random string in production)
JWT_SECRET=generate_a_random_secure_secret_here
JWT_ALGORITHM=HS256

# Database Connection (Optional)
# If provided, connects to MongoDB. If omitted, falls back to local_db.json
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ainewsplatform?retryWrites=true&w=majority

# Relational Database URL (Optional: PostgreSQL / Supabase)
# If omitted, falls back to local SQLite (sql_app.db)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Frontend URL (For CORS whitelist in production when frontend is hosted separately)
# FRONTEND_URL=https://your-frontend.vercel.app

# Server Port (Render / Railway / Cloud providers set this automatically)
PORT=8000
